# Google Calendar Checker - Environment Variables

# ======================
# Notifier Configuration
# ======================

# Home Assistant webhook URL
# Получите webhook ID из Home Assistant и замените YOUR-WEBHOOK-ID
WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/YOUR-WEBHOOK-ID

# Часовой пояс для планировщика
# Примеры: Europe/Moscow, America/New_York, Asia/Tokyo
TIMEZONE=Europe/Moscow

# Таймаут HTTP запросов (в секундах)
HTTP_TIMEOUT=10

# ======================
# Polling Configuration
# ======================

# Часы работы polling сервера (Московское время)
POLL_START_HOUR=9
POLL_END_HOUR=19

# Интервал опроса (в минутах)
# Опросы всегда происходят в :00 и :30
POLL_INTERVAL_MINUTES=30

# ======================
# Calendar Checker Configuration (опционально)
# ======================

# Пути к файлам credentials и token (по умолчанию в calendar_checker/)
# CREDENTIALS_FILE=calendar_checker/credentials.json
# TOKEN_FILE=calendar_checker/token.json

# ID календаря (по умолчанию primary)
# CALENDAR_ID=primary
